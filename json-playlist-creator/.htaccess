# JSON Playlist Creator: Apache rules (nginx: see docs/nginx.conf; PHP's built-in server: router.php).
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Private folders and files are never served.
  RewriteRule ^(app|data|tools)(/|$) - [R=404,L]
  RewriteRule (^|/)\. - [R=404,L]
  RewriteRule ^(router\.php|.*\.md)$ - [R=404,L]
  # Media URL forms → stream.php
  RewriteRule ^(live|movie|series)/([^/]+)/([^/]+)/(\d+)(?:\.(\w+))?$ stream.php?type=$1&u=$2&p=$3&id=$4&ext=$5 [L,QSA]
  RewriteRule ^timeshift/([^/]+)/([^/]+)/(\d+)/([^/]+)/(\d+)(?:\.\w+)?$ stream.php?type=timeshift&u=$1&p=$2&duration=$3&start=$4&id=$5 [L,QSA]
</IfModule>

# Without mod_rewrite, at least keep private files closed.
<IfModule !mod_rewrite.c>
  <FilesMatch "\.(json|md|log|lock)$|^router\.php$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
AddType application/vnd.apple.mpegurl .m3u8
AddType video/mp2t .ts
